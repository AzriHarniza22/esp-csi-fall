# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.0 Project Minimal Configuration
#
CONFIG_PARTITION_TABLE_OFFSET=0xa000
# NimBLE pushed the binary to 1,166,736 bytes, which does not fit the 1M
# single-app partition. The large table only grows the app partition - NVS and
# phy_init stay at the same offsets, so stored Wi-Fi credentials survive the
# reflash.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP32_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_SENSING_DEFAULT_PRESENCE_SENSITIVITY=250
# 100 Hz (300 pings/s over three channels) was measured to be more traffic than
# the router needs to answer, and it starved the radar of frames it could measure.
CONFIG_ESP_WIFI_SENSING_PING_FREQUENCY_HZ=10
# The HT stimulus is what keeps OFDM frames on the air. With it off the motion
# graph held one value for up to 6 s at a time; 200 KB every 100 ms was the
# smoothest of the burst/pause combinations measured.
CONFIG_ESP_WIFI_SENSING_HT_STIMULUS_BURST=200000
CONFIG_ESP_WIFI_SENSING_HT_STIMULUS_PAUSE_MS=100

# ---------------------------------------------------------------------------
# Bluetooth Low Energy probe
#
# NimBLE rather than Bluedroid: this unit has under 80 KB of heap free with the
# radar running, and the Bluedroid stack does not fit in that. Bluetooth
# Classic is switched off entirely since nothing here needs it, which leaves
# more of the single radio for Wi-Fi.
#
# The Wi-Fi IRAM optimisation is off because IRAM is shared with the Bluetooth
# controller, and leaving it on is what the official coexistence example does
# not do.
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=n
